# Credenciales de la app (portal de developers de Commercy → Credenciales)
COMMERCY_CLIENT_ID=app_TU_CLIENT_ID
COMMERCY_CLIENT_SECRET=cs_TU_CLIENT_SECRET

# Secreto de webhook (portal → Webhooks). Se usa para verificar la firma HMAC.
COMMERCY_WEBHOOK_SECRET=whsec_TU_WEBHOOK_SECRET

# URL pública de esta app. En desarrollo es la del túnel de cloudflared;
# debe coincidir EXACTO con la redirect URI cargada en el portal.
APP_BASE_URL=https://tu-tunnel.trycloudflare.com

# Puerto local del servidor
PORT=3000

# Versión de la API pública
COMMERCY_API_VERSION=2026-10

# Demo: protegelo antes de exponerlo. Si está seteado, /dashboard y /api/* exigen
# ?token=<valor> o el header "Authorization: Bearer <valor>". Si no, quedan abiertos.
DASHBOARD_TOKEN=
