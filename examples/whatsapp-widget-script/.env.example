# ---- Se leen al hacer `npm run build` (se "hornean" dentro del script) ----

# Número de WhatsApp en formato internacional, sólo dígitos, sin "+" ni espacios.
# Argentina celular: 54 9 + código de área + número. Ej. 5491112345678
WHATSAPP_NUMBER=5491112345678

# Mensaje inicial. {store} = nombre de la tienda (Commercy.store.name).
WHATSAPP_MESSAGE=Hola {store}! Quería hacerles una consulta.

# Mensaje cuando el visitante está viendo un producto. {product} = nombre del producto.
WHATSAPP_MESSAGE_PRODUCT=Hola {store}! Quería consultar por {product}.

# Lado de la pantalla: right | left
WIDGET_POSITION=right

# Celulares (pantallas <= 767 px): píxeles que se dejan libres abajo para no tapar la barra
# de navegación fija de la tienda (más el safe-area del iPhone, que se suma solo).
# 72 va bien para una barra de ~64 px. Poné 0 si tu tienda no tiene barra inferior.
# En escritorio no tiene efecto.
MOBILE_BOTTOM_OFFSET=72

# Base pública donde vas a servir el archivo (para el bloque JSON del portal).
# Con túnel: https://algo.trycloudflare.com  ·  En producción: https://cdn.tuapp.com
SCRIPT_BASE_URL=https://cdn.tuapp.com

# ---- Se lee al hacer `npm run serve` ----
PORT=8787
