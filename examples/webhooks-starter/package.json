{
  "name": "commercy-webhooks-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Receptor mínimo y correcto de webhooks de Commercy: firma HMAC, ventana de tiempo, deduplicación y los 4 eventos obligatorios.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node ../../scripts/smoke/webhooks-starter.mjs"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.12"
  }
}
