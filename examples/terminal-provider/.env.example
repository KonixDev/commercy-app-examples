# Secreto de webhook de la app (portal de developers de Commercy → Webhooks).
# Es el `whsec_...` COMPLETO: con él Commercy firma sus requests y vos firmás el aviso que le mandás.
COMMERCY_WEBHOOK_SECRET=whsec_TU_WEBHOOK_SECRET

# Secreto ANTERIOR. Sólo mientras rotás el secreto: se aceptan requests firmados con cualquiera de los dos
# (Commercy firma con el nuevo desde el momento de la rotación). Borralo pasadas las 72 horas.
# COMMERCY_WEBHOOK_SECRET_PREVIOUS=whsec_EL_SECRETO_VIEJO

# API de Commercy: de acá sale /api/v1/app-webhooks/:installationId
# El valor de abajo es PRODUCCIÓN (y el default si no la definís). Para probar contra otro
# entorno (staging, local) cambiala; si no, los avisos van a producción.
COMMERCY_API_BASE=https://api.commercy.com.ar

# Token del simulador (/admin/*): con él aprobás, rechazás o cancelás un cobro "desde afuera".
# Sin token, /admin está apagado (404). Usá uno largo y al azar: `openssl rand -hex 24`.
ADMIN_TOKEN=cambiame-por-un-token-largo

# Lo que declarás en el portal (pestaña «Cobro presencial»). Los valores de abajo son los defaults.
# MODES=device,qr,none          # device | qr | none
# CANCEL_MODE=sync              # sync | async | unsupported
# AMOUNT_MIN=1.00               # string con dos decimales
# AMOUNT_MAX=500000.00
# DEVICES=[{"id":"reader_01","label":"Caja 1","status":"online"},{"id":"reader_02","label":"Caja 2","status":"online"}]
#   ^ demo: toda instalación ve los mismos lectores. Un procesador real los asigna POR instalación:
# DEVICES={"<installation_id>":[{"id":"reader_01","label":"Caja 1","status":"online"}]}
#   id del lector: A-Za-z0-9_.:- (1 a 128, sin ".."). Commercy descarta en silencio de la lista los que tengan otro id.

# Datos que se muestran en el QR y en el modo "none" (transferencia). Los defaults son válidos pero de mentira:
# el CVU, el CUIT y el alias se validan al arrancar con las mismas reglas que Commercy.
# MERCHANT_NAME=Ñandú Pagos      # hasta 25 caracteres (con «ñ» a propósito: el CRC del QR va sobre bytes UTF-8)
# MERCHANT_CITY=CABA             # hasta 15 caracteres
# TRANSFER_CVU=0000003101000000000001
# TRANSFER_ALIAS=tienda.pagos
# TRANSFER_HOLDER_NAME=Tienda SRL
# TRANSFER_HOLDER_CUIT=30-71234567-1

# Puerto local del servidor
PORT=3000
