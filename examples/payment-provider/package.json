{
  "name": "commercy-example-payment-provider",
  "version": "1.0.0",
  "private": true,
  "description": "Pasarela de pagos de ejemplo («Pagos Ejemplo») para el ecosistema de apps de Commercy: sesión de cobro, checkout hospedado, estado y webhook firmado.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node ../../scripts/smoke/payment-provider.mjs"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.12"
  }
}
