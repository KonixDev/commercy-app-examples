# Secreto de webhook de la app (portal de developers de Commercy → Webhooks).
# Es el `whsec_...` COMPLETO: con él Commercy firma sus requests y vos firmás el webhook que le mandás.
COMMERCY_WEBHOOK_SECRET=whsec_TU_WEBHOOK_SECRET

# URL pública de esta app (la misma que cargás como `appUrl` en el portal).
# Tiene que ser https y de un dominio propio (no IP, no localhost). El checkout_url de cada
# sesión se arma con esta base, así que comparte el dominio registrable con el appUrl.
# En desarrollo es la URL del túnel de cloudflared.
APP_BASE_URL=https://pagos.tuapp.com

# Credenciales OAuth (portal → Credenciales). Sólo hacen falta para la instalación (/install).
# La redirect URI a cargar en el portal es ${APP_BASE_URL}/callback
COMMERCY_CLIENT_ID=app_TU_CLIENT_ID
COMMERCY_CLIENT_SECRET=cs_TU_CLIENT_SECRET

# API de Commercy: de acá salen /oauth/apps/* y /api/v1/app-webhooks/:installationId
COMMERCY_API_BASE=https://api.commercy.com.ar

# Puerto local del servidor
PORT=3000

# Dónde se guarda el estado (JSON). Ver nota de persistencia en el README.
DATA_FILE=.data/state.json
