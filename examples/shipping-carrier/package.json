{
  "name": "commercy-shipping-carrier",
  "version": "1.0.0",
  "private": true,
  "description": "App de envío de ejemplo para Commercy: cotiza, crea y cancela envíos (requests firmados) e informa el seguimiento con la API pública.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node ../../scripts/smoke/shipping-carrier.mjs"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.12"
  }
}
