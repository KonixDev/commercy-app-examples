# Credenciales de la app (portal de developers de Commercy → Credenciales).
# Sólo hacen falta para instalar la app y empujar el seguimiento.
# Para probar cotizar/crear/cancelar en local alcanza con COMMERCY_WEBHOOK_SECRET.
COMMERCY_CLIENT_ID=app_TU_CLIENT_ID
COMMERCY_CLIENT_SECRET=cs_TU_CLIENT_SECRET

# Secreto de webhook de tu app (portal → Webhooks), el `whsec_...` completo.
# Con este secreto Commercy firma los requests a /commercy/shipping/*.
COMMERCY_WEBHOOK_SECRET=whsec_TU_WEBHOOK_SECRET

# URL pública de esta app. En desarrollo es la del túnel de cloudflared;
# la redirect URI del portal debe ser exactamente <APP_BASE_URL>/callback.
# Es también la `apiBaseUrl` que le pasás a soporte para habilitar tu app como carrier.
APP_BASE_URL=https://tu-tunnel.trycloudflare.com

# Puerto local del servidor
PORT=3000

# Versión de la API pública
COMMERCY_API_VERSION=2026-10
