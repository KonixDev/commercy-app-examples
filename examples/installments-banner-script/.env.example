# ---- Se leen al hacer `npm run build` (se "hornean" dentro del script) ----

# Cantidad de cuotas sin interés que muestra el banner.
INSTALLMENTS_COUNT=6

# Compra mínima: el banner sólo aparece si el precio del producto es >= a este monto
# (en la moneda de la tienda). 0 = siempre.
INSTALLMENTS_MIN_AMOUNT=20000

# Opcional: selector CSS de un elemento de la ficha de producto (ej. el precio) después
# del cual insertar el banner. Cada tema es distinto: miralo en tu tienda de prueba.
# Vacío (o si no se encuentra) = cartel fijo abajo a la izquierda.
BANNER_ANCHOR=

# Base pública donde vas a servir el archivo (para el bloque JSON del portal).
# Con túnel: https://algo.trycloudflare.com  ·  En producción: https://cdn.tuapp.com
SCRIPT_BASE_URL=https://cdn.tuapp.com

# ---- Se lee al hacer `npm run serve` ----
PORT=8788
